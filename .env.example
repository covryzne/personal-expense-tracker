# .env.example — template TANPA nilai asli. Salin ke .env hanya oleh setup.sh
# (dan hanya bila .env belum ada). Nilai asli diserahkan lewat Secure Vault,
# tidak pernah ditulis dari chat. Lihat docs/SETUP.md Langkah 3.

# Project Supabase khusus finance (Settings -> API di dashboard project)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_PLACEHOLDER
SUPABASE_SECRET_KEY=sb_secret_PLACEHOLDER

# UUID Supabase Auth user owner (Authentication -> Users). Diinjeksi server-side
# ke setiap operasi; tidak pernah dipilih oleh LLM/pengguna lewat chat.
FINANCE_OWNER_USER_ID=00000000-0000-0000-0000-000000000000

# Allowlist adapter: chat_id side-chat WhatsApp Muse yang terdaftar.
ALLOWED_WHATSAPP_CHAT_ID=PLACEHOLDER_CHAT_ID

# Batas aman laporan custom (hari) — usulan default, dikonfirmasi Phase 1.
REPORT_MAX_RANGE_DAYS=366

# Zona waktu pelaporan (tetap untuk MVP).
APP_TIMEZONE=Asia/Jakarta
